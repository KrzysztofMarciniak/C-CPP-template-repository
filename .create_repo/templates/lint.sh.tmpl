#!/bin/sh
# scripts/lint.sh
# Runs clang-tidy over project sources. Uses compile_commands.json if one
# exists (generate it with `cmake -B build` or `bear -- make`), otherwise
# falls back to a plain compile line.
set -eu

if ! command -v clang-tidy >/dev/null 2>&1; then
  echo "clang-tidy not found - install it and re-run" >&2
  exit 1
fi

FILES=$(find src -type f \( -name '*.@@SRC_EXT@@' \) 2>/dev/null || true)

if [ -z "$FILES" ]; then
  echo "no source files found"
  exit 0
fi

status=0
if [ -f compile_commands.json ]; then
  for f in $FILES; do
    clang-tidy -p . "$f" || status=1
  done
else
  # clang-tidy wants: <files...> -- <compiler flags>, so files must come
  # before the flags - can't just xargs-append flags after the file list.
  for f in $FILES; do
    clang-tidy "$f" -- -std=@@STD@@ -Iinclude || status=1
  done
fi
exit "$status"
