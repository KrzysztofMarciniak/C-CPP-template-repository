#!/bin/sh
# configure
# Minimal, dependency-free configure script (no autoconf/automake needed).
# Probes for a compiler, parses options, and writes config.mk, which the
# Makefile includes. Re-run any time to reconfigure.

set -eu

PREFIX=/usr/local
CC_OPT="@@CC@@"
DEBUG=0
ASAN=0

for arg in "$@"; do
  case "$arg" in
    --prefix=*)   PREFIX="${arg#*=}" ;;
    --cc=*)       CC_OPT="${arg#*=}" ;;
    --enable-debug) DEBUG=1 ;;
    --enable-asan)  ASAN=1 ;;
    -h|--help)
      cat <<EOF
Usage: ./configure [options]

  --prefix=PATH     install prefix (default: /usr/local)
  --cc=COMPILER     compiler to use (default: @@CC@@)
  --enable-debug    build with -g -O0
  --enable-asan     build with -fsanitize=address,undefined
  -h, --help        show this help
EOF
      exit 0
      ;;
    *)
      echo "configure: unknown option '$arg'" >&2
      exit 1
      ;;
  esac
done

echo "checking for $CC_OPT... "
if ! command -v "$CC_OPT" >/dev/null 2>&1; then
  echo "  not found" >&2
  exit 1
fi
echo "  found: $(command -v "$CC_OPT")"

CFLAGS="-std=@@STD@@ -Wall -Wextra -Wpedantic -Iinclude"
if [ "$DEBUG" -eq 1 ]; then
  CFLAGS="$CFLAGS -g -O0"
fi
LDFLAGS=""
if [ "$ASAN" -eq 1 ]; then
  CFLAGS="$CFLAGS -fsanitize=address,undefined -g -O0"
  LDFLAGS="$LDFLAGS -fsanitize=address,undefined"
fi

cat > config.mk <<EOF
# generated by ./configure - do not edit by hand, re-run ./configure instead
CC       = $CC_OPT
PREFIX   = $PREFIX
CFLAGS   = $CFLAGS
LDFLAGS  = $LDFLAGS
EOF

echo
echo "configured:"
echo "  compiler: $CC_OPT"
echo "  prefix:   $PREFIX"
echo "  cflags:   $CFLAGS"
echo
echo "now run: make"
