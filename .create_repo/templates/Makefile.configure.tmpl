-include config.mk

CC       ?= @@CC@@
PREFIX   ?= /usr/local
CFLAGS   ?= -std=@@STD@@ -Wall -Wextra -Wpedantic -Iinclude
LDFLAGS  ?=

SRC      := $(wildcard src/*.@@SRC_EXT@@)
OBJ      := $(SRC:src/%.@@SRC_EXT@@=build/%.o)
DEP      := $(OBJ:.o=.d)
BIN      := build/@@PROJECT_NAME@@

.PHONY: all run clean distclean install uninstall format lint test help

all: config.mk $(BIN)

config.mk:
	@echo "note: config.mk not found - run ./configure first (using defaults for now)"
	@touch config.mk

$(BIN): $(OBJ)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -o $@ $(OBJ) $(LDFLAGS)
	@echo "built: $@"

-include $(DEP)

build/%.o: src/%.@@SRC_EXT@@
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

run: all
	./$(BIN)

install: all
	install -d $(DESTDIR)$(PREFIX)/bin
	install -m 755 $(BIN) $(DESTDIR)$(PREFIX)/bin/@@PROJECT_NAME@@

uninstall:
	rm -f $(DESTDIR)$(PREFIX)/bin/@@PROJECT_NAME@@

format:
	@./scripts/format.sh

lint:
	@./scripts/lint.sh

test:
	@echo "wire up tests/ here"

clean:
	rm -rf build

distclean: clean
	rm -f config.mk

help:
	@echo "targets:"
	@echo "  all        build $(BIN) (run ./configure first)"
	@echo "  run        build and run"
	@echo "  install    install to PREFIX"
	@echo "  uninstall  remove installed binary"
	@echo "  format     run scripts/format.sh"
	@echo "  lint       run scripts/lint.sh"
	@echo "  test       run the test suite"
	@echo "  clean      remove build/"
	@echo "  distclean  clean + remove config.mk"
