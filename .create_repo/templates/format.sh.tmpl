#!/bin/sh
# scripts/format.sh
# Runs clang-format -i over every C/C++ source and header in the project.
# Uses .clang-format if present, otherwise clang-format's built-in default
# style.
set -eu

if ! command -v clang-format >/dev/null 2>&1; then
  echo "clang-format not found - install it and re-run" >&2
  exit 1
fi

FILES=$(find src include tests examples -type f \
  \( -name '*.c' -o -name '*.h' -o -name '*.cpp' -o -name '*.hpp' \
     -o -name '*.cc' -o -name '*.hh' \) 2>/dev/null || true)

if [ -z "$FILES" ]; then
  echo "no source files found"
  exit 0
fi

echo "$FILES" | xargs clang-format -i
echo "formatted."
